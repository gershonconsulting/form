# Anthropic API key for the Claude proxy (server-only — NEVER expose to the client).
# Used by app/api/research and app/api/chat. Edge runtime accesses this via process.env.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Airtable — every signed intake becomes one row in the "Submissions" table of the
# "Gershon Onboarding" base. Quote files upload as native attachments on that row.
# PAT scope: data.records:read + data.records:write on the Gershon Onboarding base.
AIRTABLE_PAT=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=app7zEt3FmwP8jMJj
AIRTABLE_TABLE=Submissions

# Pinned Node version for Cloudflare Pages build environment.
NODE_VERSION=20.11.1

# Resend — courtesy email of every signed intake to the Gershon team.
# App works without these; you just don't get the email copy.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
GERSHON_NOTIFY_TO=olivier@gershon.ai
GERSHON_NOTIFY_FROM=Onboarding <onboarding@form.gershoncrm.com>
