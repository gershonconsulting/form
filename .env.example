# Anthropic API key for the Claude proxy (server-only — NEVER expose to the client).
# Used by app/api/research and app/api/chat. Edge runtime accesses this via process.env.
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Supabase — the public URL is fine to ship in the bundle, but the service role key
# is server-only and must stay in Cloudflare Pages encrypted env vars.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ.XXXXXXXXXXXXXXXXXXXXXXXX

# Pinned Node version for Cloudflare Pages build environment.
NODE_VERSION=20.11.1

# Resend — used by app/api/submit to email a copy of every signed intake to Gershon.
# If RESEND_API_KEY is unset, the submission still saves to Supabase but no email is sent.
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
GERSHON_NOTIFY_TO=olivier@gershon.ai
GERSHON_NOTIFY_FROM=Onboarding <onboarding@form.gershoncrm.com>
